# Backend configuration. Copy to .env and adjust. Never commit real secrets.
PORT=8787
# Leave empty to run with the in-memory store (data resets on restart).
DATABASE_URL=
# Comma-separated list of origins allowed to call the API in development.
CORS_ORIGINS=http://localhost:5173
# Requests per minute per IP.
RATE_LIMIT_PER_MINUTE=120

# Where prices come from: community (default, shoppers share what they see),
# feed (set automatically when PRICE_FEED_URL is set) or demo (development only).
PRICE_SOURCE=
# Licensed price feed (optional). See docs/price-feed.md.
PRICE_FEED_URL=
PRICE_FEED_KEY=
